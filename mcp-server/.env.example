# Variables del servidor MCP. Cargalas en Railway > servicio mcp-server > Variables.
# Este archivo documenta los NOMBRES: nunca pongas valores reales aca.

# Backend de CotizadorQ (sin barra final)
COTIZADOR_API_URL=https://cotizadorq-backend-production.up.railway.app

# Cuenta de servicio dedicada, rol "client", con GP QNAP 15% y GP AXIS 13%.
# NO uses una cuenta admin: con rol admin el backend acepta los precios que se
# le manden sin recalcularlos.
COTIZADOR_USER=
COTIZADOR_PASS=

# Secreto que protege el acceso al MCP. Genera uno largo y aleatorio.
# Se acepta como "Authorization: Bearer <secreto>" o como /mcp/<secreto>.
CONNECTOR_SECRET=

# Opcionales
COTIZADOR_TIMEOUT_MS=30000
COTIZADOR_MAX_RETRIES=3
CATALOGO_TTL_MIN=10
STOCK_TTL_MIN=5

# Dominios extra autorizados (coma-separados). El dominio propio de Railway se
# autoriza solo via RAILWAY_PUBLIC_DOMAIN; esto es para custom domains.
MCP_ALLOWED_HOSTS=

# Identidad de sesion del bot ante CotizadorQ. Opcionales: si no se definen se
# genera un session id por proceso. Fijar MCP_SESSION_ID lo hace estable entre
# reinicios y evita revocaciones innecesarias.
MCP_SESSION_ID=
MCP_DEVICE_ID=mcp-server
