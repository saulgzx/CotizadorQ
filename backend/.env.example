DATABASE_URL=postgresql://usuario:password@host:puerto/database
PORT=3001
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_DE_AL_MENOS_32_CARACTERES
ALLOWED_ORIGINS=https://myquoteag.vercel.app,https://www.myquoteag.vercel.app,http://localhost:5173
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MIN=15
# false desactiva el limite de intentos de login (no recomendado)
LOGIN_RATE_LIMIT_ENABLED=true
# true exige certificado valido del servidor PostgreSQL (recomendado si el proveedor lo soporta)
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Horas entre syncs automaticos del catalogo desde Google Sheets (<=0 desactiva el job)
GOOGLE_SHEETS_SYNC_HOURS=12
# Geolocalizacion de conexiones por IP (mapa de usuarios + deteccion de uso compartido).
# false la desactiva; envia la IP del usuario al servicio externo ipwho.is en cada login.
GEO_ENABLED=true
GEO_API_TIMEOUT_MS=2500
# Proxies a confiar para obtener la IP real del cliente. Si el backend esta detras de
# varios proxies (CDN + hosting) y el mapa no localiza sesiones, probar 'true' o subir el numero.
TRUST_PROXY=1
STOCK_CACHE_TTL_SEC=120
STOCK_CATALOG_CACHE_TTL_SEC=180
OSO_ORDERS_CACHE_TTL_SEC=120
GOOGLE_API_TIMEOUT_MS=12000
GOOGLE_API_RETRIES=2
GOOGLE_API_RETRY_DELAY_MS=300
NODE_ENV=production
# Asistente IA (tab "Asistente IA", solo admin). Sin estas tres variables el tab avisa que falta configurar.
# API key de https://platform.claude.com (se cobra por uso, aparte de la suscripcion de claude.ai)
ANTHROPIC_API_KEY=
# Servidor MCP de MyQuote (servicio mcp-server en Railway) y su CONNECTOR_SECRET
MYQUOTE_MCP_URL=https://TU-MCP.up.railway.app/mcp
MYQUOTE_MCP_TOKEN=
# Opcionales
IA_MODEL=claude-opus-5-5
IA_EFFORT=medium
IA_MAX_TOKENS=32000
