DATABASE_URL=postgresql://usuario:password@host:puerto/database
PORT=3001
# Al arrancar se exige conexion a PostgreSQL: intentos y espera base (ms, crece con cada intento).
# Si no conecta, el proceso termina con codigo 1 para que Railway lo reinicie.
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_DELAY_MS=3000
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_DE_AL_MENOS_32_CARACTERES
ALLOWED_ORIGINS=https://myquoteag.vercel.app,https://www.myquoteag.vercel.app,http://localhost:5173
# Duracion de sesion. No admin: SESSION_TTL_MIN de inactividad y JWT de 24h.
# Admin: ADMIN_SESSION_TTL_MIN de inactividad (default 10080 = 7 dias) y JWT de
# ADMIN_JWT_EXPIRES_IN (default 7d; formato de jsonwebtoken: 12h, 7d, ...).
SESSION_TTL_MIN=10
ADMIN_SESSION_TTL_MIN=10080
ADMIN_JWT_EXPIRES_IN=7d
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MIN=15
# false desactiva el limite de intentos de login (no recomendado)
LOGIN_RATE_LIMIT_ENABLED=true
# true exige certificado valido del servidor PostgreSQL (recomendado si el proveedor lo soporta)
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Horas entre syncs automaticos del catalogo desde Google Sheets (<=0 desactiva el job)
GOOGLE_SHEETS_SYNC_HOURS=12
# Geolocalizacion de conexiones por IP (mapa de usuarios + deteccion de uso compartido).
# false la desactiva; envia la IP del usuario por HTTPS a ipwho.is (respaldo: ipapi.co) en cada login.
GEO_ENABLED=true
GEO_API_TIMEOUT_MS=2500
# Proxies a confiar para obtener la IP real del cliente. Si el backend esta detras de
# varios proxies (CDN + hosting) y el mapa no localiza sesiones, probar 'true' o subir el numero.
TRUST_PROXY=1
STOCK_CACHE_TTL_SEC=120
STOCK_CATALOG_CACHE_TTL_SEC=180
OSO_ORDERS_CACHE_TTL_SEC=120
GOOGLE_API_TIMEOUT_MS=12000
GOOGLE_API_RETRIES=2
GOOGLE_API_RETRY_DELAY_MS=300
NODE_ENV=production
# Asistente IA (tab "Asistente IA", solo admin).
# Modo agente (recomendado): el miniPC del usuario resuelve las consultas con Claude Code
# y su suscripcion. Ver agente-ia/README.md. Si esta definido, tiene prioridad sobre la API.
IA_AGENTE_TOKEN=
# Usuarios de MyQuote que pueden usar el asistente (coma-separados). Vacio: todos los admin.
IA_USUARIOS=

# Modo API (respaldo, se cobra por uso): API key de https://platform.claude.com
ANTHROPIC_API_KEY=
# Servidor MCP de MyQuote (servicio mcp-server en Railway) y su CONNECTOR_SECRET
MYQUOTE_MCP_URL=https://TU-MCP.up.railway.app/mcp
MYQUOTE_MCP_TOKEN=
IA_MODEL=claude-opus-5-5
IA_EFFORT=medium
IA_MAX_TOKENS=32000

# Usuarios de servicio (coma-separados) que pueden usar POST /api/precios/calcular
# ademas de los admin: costos, rebates por nivel de partner y GP. Pon aca la
# cuenta del conector MCP (ej. mcp_bot) para que el asistente IA calcule precios
# Silver/Gold/Multiregional y con otro margen.
PRECIOS_USUARIOS=

# WhatsApp (opcional). Ver agente-ia/WHATSAPP.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Numeros autorizados, con codigo de pais y sin +: 56912345678
WHATSAPP_NUMEROS=
