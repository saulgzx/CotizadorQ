# Copia este archivo como .env (en esta misma carpeta) y completa los valores.

# URL del backend de MyQuote (sin barra final)
MYQUOTE_API_URL=https://cotizadorq-backend-production.up.railway.app

# El mismo valor que IA_AGENTE_TOKEN en Railway (servicio cotizadorQ-backend)
IA_AGENTE_TOKEN=

# Nombre con que agregaste el conector en Claude Code (claude mcp add ... myquote ...)
MCP_NOMBRE=myquote

# Seguimiento por correo (Outlook). Nombre del servidor MCP del conector de Microsoft 365
# tal como lo ve Claude Code. Con el conector de claude.ai suele ser claude_ai_Microsoft_365.
# Compruebalo con: npm run probar-correo (si no coincide, te sugiere el valor).
MCP_CORREO=claude_ai_Microsoft_365

# Opcionales
# SEGUIMIENTO_CORREO=0      # no pedir tareas de correo (solo consultas)
# TIMEOUT_TAREA_MIN=12      # maximo por tarea de correo (el backend reencola a los 15)
# CLAUDE_BIN=claude
# CLAUDE_MODEL=opus
# TIMEOUT_MIN=10

# Auto-actualizacion: con el agente ocioso hace "git fetch origin main" y, si esta
# atrasado, con el arbol limpio y en la rama main, "git pull --ff-only" y se
# reinicia (sale con codigo 75; lo relanza iniciar.mjs). Nunca toca cambios locales.
# AUTO_ACTUALIZAR=0 la apaga. Cada cuantos minutos revisa (por defecto 10):
# AUTO_ACTUALIZAR=1
# AUTO_ACTUALIZAR_MIN=10
